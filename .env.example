# Copy to .env (never commit .env) or set these as environment variables.
# Only variable names live here: no values, no keys.

# Anthropic (default provider). ANTHROPIC_MODEL is optional (default: claude-opus-5-5).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# OpenAI-compatible provider (OpenAI, or a local server such as Ollama).
# For Ollama: no key needed; set OPENAI_MODEL to a model with tool calling (e.g. qwen2.5:7b)
# and run with:  reviewlens -e configs/agent/ollama.yaml agent chat "..."
OPENAI_API_KEY=
OPENAI_MODEL=
